# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API (the React app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data mode: `live` calls providers, `demo` never does.
# Live mode also requires ORS_API_KEY; without it the API runs in demo mode.
DATA_MODE=live
# In live mode, fall back to clearly labelled simulated data when a provider fails
DEMO_FALLBACK=True

# OpenRouteService key (https://openrouteservice.org/dev/#/signup). Backend only, never ship to the browser.
ORS_API_KEY=
# Open-Meteo needs no key (free tier is non-commercial; see README).

# Per-request timeout for provider calls, seconds
PROVIDER_TIMEOUT_S=8
# How long analysis results stay retrievable by route id, seconds
RESULT_TTL_S=3600
# Per-client limit on POST /api/routes/analyze/
ANALYZE_RATE=30/min
LOG_LEVEL=INFO
